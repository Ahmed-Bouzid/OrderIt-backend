# MongoDB
MONGO_URI=mongodb://localhost:27017/orderit

# JWT
JWT_SECRET=votre_secret_jwt
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=votre_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Google Vision API (OCR)
# Option 1 : Credentials JSON (recommandé pour production)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2 : API Key (plus simple pour dev)
# GOOGLE_VISION_API_KEY=votre_api_key

# Port
PORT=5000
